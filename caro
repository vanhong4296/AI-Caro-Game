import tkinter as tk
import time

# ==============================
# CÁC BIẾN THỐNG KÊ
# ==============================

node_count = 0
algorithm = "Alpha-Beta"

# ==============================
# KIỂM TRA NGƯỜI THẮNG
# ==============================

def check_winner(board):
    # Kiểm tra hàng
    for row in board:
        if row[0] == row[1] == row[2] != "":
            return row[0]

    # Kiểm tra cột
    for col in range(3):
        if board[0][col] == board[1][col] == board[2][col] != "":
            return board[0][col]

    # Kiểm tra đường chéo
    if board[0][0] == board[1][1] == board[2][2] != "":
        return board[0][0]

    if board[0][2] == board[1][1] == board[2][0] != "":
        return board[0][2]

    return None


# ==============================
# KIỂM TRA HÒA
# ==============================

def is_full(board):
    for row in board:
        for cell in row:
            if cell == "":
                return False
    return True


# ==============================
# THUẬT TOÁN MINIMAX
# ==============================

def minimax(board, depth, is_maximizing):
    global node_count
    node_count += 1

    winner = check_winner(board)

    if winner == "O":
        return 10 - depth
    elif winner == "X":
        return depth - 10
    elif is_full(board):
        return 0

    if is_maximizing:
        best_score = -float("inf")

        for i in range(3):
            for j in range(3):
                if board[i][j] == "":
                    board[i][j] = "O"
                    score = minimax(board, depth + 1, False)
                    board[i][j] = ""

                    best_score = max(score, best_score)

        return best_score

    else:
        best_score = float("inf")

        for i in range(3):
            for j in range(3):
                if board[i][j] == "":
                    board[i][j] = "X"
                    score = minimax(board, depth + 1, True)
                    board[i][j] = ""

                    best_score = min(score, best_score)

        return best_score


# ==============================
# ALPHA-BETA PRUNING
# ==============================

def alpha_beta(board, depth, alpha, beta, is_maximizing):
    global node_count
    node_count += 1

    winner = check_winner(board)

    if winner == "O":
        return 10 - depth
    elif winner == "X":
        return depth - 10
    elif is_full(board):
        return 0

    if is_maximizing:
        best_score = -float("inf")

        for i in range(3):
            for j in range(3):
                if board[i][j] == "":
                    board[i][j] = "O"

                    score = alpha_beta(
                        board, depth + 1,
                        alpha, beta, False
                    )

                    board[i][j] = ""

                    best_score = max(best_score, score)
                    alpha = max(alpha, best_score)

                    # Cắt tỉa nhánh
                    if beta <= alpha:
                        break

        return best_score

    else:
        best_score = float("inf")

        for i in range(3):
            for j in range(3):
                if board[i][j] == "":
                    board[i][j] = "X"

                    score = alpha_beta(
                        board, depth + 1,
                        alpha, beta, True
                    )

                    board[i][j] = ""

                    best_score = min(best_score, score)
                    beta = min(beta, best_score)

                    # Cắt tỉa nhánh
                    if beta <= alpha:
                        break

        return best_score


# ==============================
# AI CHỌN NƯỚC ĐI
# ==============================

def ai_move():
    global node_count

    best_score = -float("inf")
    move = None

    node_count = 0
    start_time = time.time()

    for i in range(3):
        for j in range(3):
            if board[i][j] == "":
                board[i][j] = "O"

                if algorithm == "Minimax":
                    score = minimax(board, 0, False)
                else:
                    score = alpha_beta(
                        board, 0,
                        -float("inf"),
                        float("inf"),
                        False
                    )

                board[i][j] = ""

                if score > best_score:
                    best_score = score
                    move = (i, j)

    end_time = time.time()

    # Hiển thị thống kê
    info_label.config(
        text=f"Thuật toán: {algorithm} | "
             f"Node: {node_count} | "
             f"Thời gian: {(end_time - start_time):.5f} giây"
    )

    if move:
        i, j = move
        board[i][j] = "O"
        buttons[i][j].config(text="O", state="disabled")

        check_game()


# ==============================
# XỬ LÝ NƯỚC ĐI CỦA NGƯỜI CHƠI
# ==============================

def player_move(i, j):
    if board[i][j] == "":
        board[i][j] = "X"
        buttons[i][j].config(text="X", state="disabled")

        if not check_game():
            window.after(300, ai_move)


# ==============================
# KIỂM TRA KẾT THÚC TRẬN ĐẤU
# ==============================

def check_game():
    winner = check_winner(board)

    if winner:
        info_label.config(text=f"🎉 Người chơi {winner} chiến thắng!")
        disable_all()
        return True

    if is_full(board):
        info_label.config(text="🤝 Trận đấu hòa!")
        return True

    return False


def disable_all():
    for i in range(3):
        for j in range(3):
            buttons[i][j].config(state="disabled")


# ==============================
# CHỌN THUẬT TOÁN
# ==============================

def set_algorithm(value):
    global algorithm
    algorithm = value
    info_label.config(text=f"Đã chọn thuật toán: {algorithm}")


# ==============================
# CHƠI LẠI
# ==============================

def reset_game():
    global board
    board = [["" for _ in range(3)] for _ in range(3)]

    for i in range(3):
        for j in range(3):
            buttons[i][j].config(text="", state="normal")

    info_label.config(text=f"Thuật toán hiện tại: {algorithm}")


# ==============================
# TẠO GIAO DIỆN TKINTER
# ==============================

window = tk.Tk()
window.title("AI Chơi Cờ Caro")

board = [["" for _ in range(3)] for _ in range(3)]
buttons = []

title = tk.Label(
    window,
    text="🎮 AI CHƠI CỜ CARO",
    font=("Arial", 18, "bold")
)
title.pack(pady=10)

# Nút chọn thuật toán
control_frame = tk.Frame(window)
control_frame.pack()

tk.Button(
    control_frame,
    text="Minimax",
    command=lambda: set_algorithm("Minimax")
).grid(row=0, column=0, padx=5)

tk.Button(
    control_frame,
    text="Alpha-Beta",
    command=lambda: set_algorithm("Alpha-Beta")
).grid(row=0, column=1, padx=5)

# Bàn cờ
board_frame = tk.Frame(window)
board_frame.pack(pady=10)

for i in range(3):
    row = []

    for j in range(3):
        button = tk.Button(
            board_frame,
            text="",
            font=("Arial", 24, "bold"),
            width=5,
            height=2,
            command=lambda i=i, j=j: player_move(i, j)
        )

        button.grid(row=i, column=j)
        row.append(button)

    buttons.append(row)

# Thông tin thuật toán
info_label = tk.Label(
    window,
    text="Chọn thuật toán và bắt đầu chơi!",
    font=("Arial", 11)
)
info_label.pack(pady=10)

# Nút chơi lại
tk.Button(
    window,
    text="🔄 Chơi lại",
    font=("Arial", 11),
    command=reset_game
).pack(pady=5)

window.mainloop()